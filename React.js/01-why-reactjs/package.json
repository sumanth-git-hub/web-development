{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.5",
    "tailwindcss": "^4.1.5"
  },
  "scripts": {
    "tailwind": "tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "tailwind-minify": "tailwindcss -i ./src/input.css -o ./src/output.css --watch --minify",
    "tailwind-pretty": "npx prettier --write index.html"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11"
  }
}
